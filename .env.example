# wombat-core (pass) — optional environment variables for the CLI
# Copy to .env and source before running: `export $(grep -v '^#' .env | xargs)`
# None of these are required — wombat-core works fully offline without them.

# ── Server push ───────────────────────────────────────────────────────────────
# Automatically POST scan results to wombat-server after every run.
# Equivalent to always passing --push <url> to `wombat check`.
# Must include the /api/v1/runs endpoint path.
WOMBAT_SERVER_URL=http://localhost:8000/api/v1/runs

# ── Internal web UI (serve/) ──────────────────────────────────────────────────
# Base directory for /api/scan, /api/auto-fix and /api/auto-fix/rollback.
# Defaults to the process working directory. Set it to the IaC workspace you
# want the internal UI to be able to read and modify.
# WOMBAT_SCAN_BASE_DIR=/path/to/your/iac/workspace

# ── Export plugins ────────────────────────────────────────────────────────────
# Values referenced as ${VAR} in .wombat-export.yml are expanded from the
# environment at load time and never stored in config files or result JSON.
# Uncomment and fill in the secrets required by your export destinations:

# GRAFANA_CLOUD_TOKEN=your-grafana-cloud-token
# DD_API_KEY=your-datadog-api-key
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# WEBHOOK_TOKEN=your-generic-webhook-secret
